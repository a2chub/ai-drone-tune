<?xml version="1.0" encoding="UTF-8"?>
<!-- Install: cp com.aidt.watch.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.aidt.watch.plist
     Install aidt first: cd <repo> && uv tool install ".[plot]", then set the path below (`which aidt`). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.aidt.watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOUR_NAME/.local/bin/aidt</string>
    <string>watch</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/aidt-watch.log</string>
  <key>StandardErrorPath</key><string>/tmp/aidt-watch.log</string>
</dict>
</plist>
