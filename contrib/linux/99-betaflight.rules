# Allow non-root access to Betaflight USB VCP (STM32 / AT32) and start the watcher when a FC is plugged in.
# Install: sudo cp 99-betaflight.rules /etc/udev/rules.d/ && sudo udevadm control --reload-rules
SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", MODE="0666", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="aidt-watch.service"
SUBSYSTEM=="tty", ATTRS{idVendor}=="2e3c", ATTRS{idProduct}=="5740", MODE="0666", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="aidt-watch.service"
